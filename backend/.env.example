# Plantilla de variables de entorno.
# Copiala a un archivo .env (que NO se versiona) y completa los valores.
#
#   cp .env.example .env

# Puerto donde escucha la API
PORT=3000

# Cadena de conexion a PostgreSQL.
# En Supabase: boton "Connect" > "Session pooler". No usar "Direct connection":
# funciona solo por IPv6, y Render no tiene salida IPv6.
# Reemplazar [YOUR-PASSWORD] por la contrasena de la base.
DATABASE_URL=

# Secreto para firmar los tokens JWT. Aleatorio y de al menos 32 caracteres.
# Quien lo conozca puede fabricar tokens de administrador. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duracion de los tokens (formato de jsonwebtoken: 30m, 8h, 1d)
JWT_EXPIRA=8h
