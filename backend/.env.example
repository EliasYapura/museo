# Plantilla de variables de entorno.
# Copiala a un archivo .env (que NO se versiona) y completa los valores.
#
#   cp .env.example .env

# Puerto donde escucha la API
PORT=3000

# Cadena de conexion a PostgreSQL.
# En Supabase: boton "Connect" > "Session pooler". No usar "Direct connection":
# funciona solo por IPv6, y Render no tiene salida IPv6.
# Reemplazar [YOUR-PASSWORD] por la contrasena de la base.
DATABASE_URL=

# Secreto para firmar los tokens JWT. Aleatorio y de al menos 32 caracteres.
# Quien lo conozca puede fabricar tokens de administrador. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duracion de los tokens (formato de jsonwebtoken: 30m, 8h, 1d)
JWT_EXPIRA=8h

# Origen de la app del visitante cuando se la corre en el navegador
# (flutter run -d edge --web-port=5000). En el emulador o en un telefono no
# hace falta: CORS es una regla de los navegadores.
APP_ORIGIN=http://localhost:5000

# Supabase Storage, donde se guardan las imagenes de las insignias (ADM25).
# La direccion del proyecto, sin barra final: Settings > Data API > Project URL.
SUPABASE_URL=

# La Secret key del proyecto: Settings > API Keys > Secret key. Empieza con
# sb_secret_. NO es la Publishable key, que respeta RLS y con la que el backend
# no podria hacer nada: nuestras tablas tienen RLS sin politicas.
# Saltea RLS por completo, asi que vive solo en el servidor y nunca en la app.
# Pegarla sola, sin comillas y sin los signos < >.
SUPABASE_SERVICE_KEY=

# Clave de la API de Anthropic, para redactar desafios con IA (ADM27).
# Se saca en console.anthropic.com > Settings > API keys > Create key, y se ve
# una sola vez. Empieza con sk-ant-. Hay que cargar credito en Billing: la API
# es prepaga y va aparte de cualquier suscripcion de Claude.
#
# Es opcional: sin ella el servidor levanta igual y lo unico que no anda es el
# boton de redactar con IA, que avisa que falta configurarla.
#
# La llamada la hace el servidor, asi que la clave nunca sale de aca ni viaja
# dentro del APK.
ANTHROPIC_API_KEY=
